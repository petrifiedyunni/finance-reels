# Optional. If omitted, the CLI still works offline on macOS:
# local storyboard + macOS say voice + labeled caption timing.
XAI_API_KEY=
XAI_TEXT_MODEL=grok-4.6

# Voice. ElevenLabs is preferred. OpenAI is the fallback.
VOICE_PROVIDER=elevenlabs
VOICE_PRESET=smart_friend

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

VOICE_SPEED=1.06
VOICE_STABILITY=0.34
VOICE_SIMILARITY=0.78
VOICE_STYLE=0.24
VOICE_SPEAKER_BOOST=true

# Offline macOS fallback. Uses the real female Siri voice (Nicky) via AVSpeech, not `say`.
LOCAL_TTS_VOICE=Nicky

# Optional. OpenAI is used for TTS fallback + word-level timestamps.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Word-level timestamps. whisper-1 is the reliable word-timestamp model.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# TikTok Content Posting API (Desktop Login Kit).
# Create a dedicated brand account in the TikTok app, then connect it with:
#   npm run tiktok -- login
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Registered redirect. Wildcard port is required for desktop Login Kit.
TIKTOK_REDIRECT_URI=http://127.0.0.1:*/callback/
# Direct-post privacy. Unaudited apps can only use SELF_ONLY.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Label TTS + generated graphics as AI-generated on direct posts.
TIKTOK_IS_AIGC=true

# Development: skip paid APIs and use local storyboards + macOS say.
MOCK_AI=false

# Only if transcription cannot return word timestamps AND you explicitly want
# labeled proportional timing instead of failing. Default is false.
FALLBACK_TIMESTAMPS=false
